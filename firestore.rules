rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBloodGroupValid(bg) {
      return bg in ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"];
    }

    function limitsPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/private/limits;
    }

    // ------------------------------------------------------------------------
    // User Profiles Rules
    // ------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["livesSaved", "donorTier"]);
      allow delete: if false;

      // Private User Data (e.g. contact details readable/writable only by owner)
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ------------------------------------------------------------------------
    // Emergency Blood Requests Rules
    // ------------------------------------------------------------------------
    match /blood_requests/{id} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == "Pending" &&
        request.resource.data.unitsNeeded is int &&
        request.resource.data.unitsNeeded >= 1 &&
        request.resource.data.unitsNeeded <= 20 &&
        request.resource.data.get("unitsReceived", 0) == 0 &&
        isBloodGroupValid(request.resource.data.bloodGroup) &&
        request.resource.data.get("verified", false) == false &&
        request.resource.data.contactNumber is string &&
        request.resource.data.contactNumber.size() >= 7 && request.resource.data.contactNumber.size() <= 20 &&
        request.resource.data.get("patientReference", "").size() <= 60 &&
        getAfter(limitsPath(request.auth.uid)).data.lastRequestAt == request.time &&
        (!exists(limitsPath(request.auth.uid)) || request.time > get(limitsPath(request.auth.uid)).data.lastRequestAt + duration.value(2, 'm'));

      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.requesterId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "urgency", "unitsReceived"]) &&
        request.resource.data.status in ["Pending", "Partially Fulfilled", "Fulfilled", "Cancelled"] &&
        request.resource.data.get("unitsReceived", 0) >= resource.data.get("unitsReceived", 0) &&
        request.resource.data.get("unitsReceived", 0) <= resource.data.unitsNeeded;

      allow delete: if false;

      // Pledges Subcollection Rules
      match /pledges/{donorUid} {
        allow create: if isSignedIn() &&
          request.auth.uid == donorUid &&
          request.resource.data.donorId == donorUid &&
          request.resource.data.status == "Pledged" &&
          (!("etaMinutes" in request.resource.data) || (request.resource.data.etaMinutes is int && request.resource.data.etaMinutes >= 5 && request.resource.data.etaMinutes <= 720));

        allow read: if isSignedIn() && (
          request.auth.uid == resource.data.donorId ||
          request.auth.uid == get(/databases/$(database)/documents/blood_requests/$(id)).data.requesterId
        );

        allow update: if isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/blood_requests/$(id)).data.requesterId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "donatedAt"]) &&
          request.resource.data.status == "Donated";

        allow delete: if isSignedIn() && request.auth.uid == donorUid;
      }
    }

    // ------------------------------------------------------------------------
    // Collection Group Query for Pledges (Donor Tier Count Query)
    // ------------------------------------------------------------------------
    match /{path=**}/pledges/{p} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.donorId;
    }

    // ------------------------------------------------------------------------
    // User Reports Rules
    // ------------------------------------------------------------------------
    match /reports/{id} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() <= 40 &&
        request.resource.data.get("details", "").size() <= 300;
      allow read, update, delete: if false;
    }

    // ------------------------------------------------------------------------
    // Blood Camps / Drives Rules
    // ------------------------------------------------------------------------
    match /camps/{id} {
      allow read: if isSignedIn();
      allow write: if false;

      match /rsvps/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // ------------------------------------------------------------------------
    // Blood Banks Rules
    // ------------------------------------------------------------------------
    match /blood_banks/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
